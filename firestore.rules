rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // STRICT REQUIREMENT 1 & 17: psgss91@gmail.com is the ONLY Super Admin
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && (request.auth.token.email == 'psgss91@gmail.com'
            || request.auth.token.email.matches('(?i)^psgss91@gmail[.]com$'));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // User accounts collection
    match /users/{userId} {
      // Super Admin (psgss91@gmail.com) can manage all users (read, create, update, delete).
      allow read, write: if isSuperAdmin();

      // Normal user can read only their own profile.
      allow get: if isOwner(userId);
      allow list: if signedIn() && (isSuperAdmin() || resource.data.uid == request.auth.uid);

      // Normal user can create only their own profile with role user/client and status pending.
      allow create: if isOwner(userId)
        && (request.resource.data.role == 'user' || request.resource.data.role == 'client')
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerEmail == 'psgss91@gmail.com';

      // Normal user can update metadata or ensure status remains 'pending', but can NEVER change role, allowedDays, expiresAt, ownerEmail, or approve themselves ('active'/'unlimited')
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'allowedDays', 'expiresAt', 'ownerEmail', 'parentAdminEmail']))
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending');

      // Normal users cannot delete profiles.
      allow delete: if isSuperAdmin();
    }

    // Access approval requests submitted to Super Admin
    match /approval_requests/{requestId} {
      // Super Admin (psgss91@gmail.com) can manage all requests.
      allow read, write: if isSuperAdmin();

      // Normal user can read only their own approval request.
      allow get: if signedIn() && (requestId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid);

      // Normal user can create an approval request for themselves with status pending.
      allow create: if signedIn()
        && (request.resource.data.userId == request.auth.uid || requestId == request.auth.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerEmail == 'psgss91@gmail.com';

      // Normal user can only update their own request if status remains pending.
      allow update: if signedIn()
        && (requestId == request.auth.uid || resource.data.userId == request.auth.uid)
        && request.resource.data.status == 'pending';

      // Normal users cannot delete approval requests.
      allow delete: if isSuperAdmin();
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
