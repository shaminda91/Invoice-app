rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'psgss91@gmail.com') ||
        (request.auth.token.firebase != null && request.auth.token.firebase.identities != null && 
         request.auth.token.email.lower() == 'psgss91@gmail.com')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if isSuperAdmin() || isOwner(userId);
      allow create: if isSuperAdmin() || isOwner(userId);
      allow update: if isSuperAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'allowedDays', 'expiresAt'])));
      allow delete: if isSuperAdmin();
    }

    // Access approval requests submitted to Super Admin
    match /approval_requests/{requestId} {
      allow read: if isSuperAdmin() || isOwner(requestId);
      allow create: if isSignedIn() && (isOwner(requestId) || request.resource.data.userId == request.auth.uid);
      allow update: if isSuperAdmin() || isOwner(requestId);
      allow delete: if isSuperAdmin();
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
